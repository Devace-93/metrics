{
  "name": "@metrics/web",
  "version": "0.1.0",
  "description": "metrics \u2014 Qwik City frontend (marketing + dashboard) for the metrics feature-flag service",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "bun run check:i18n && bun run build.types && bun run build.client && bun run build.server",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/node-server/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "preview": "qwik build preview && vite preview --open",
    "serve": "bun ./server/entry.node-server.js",
    "start": "bun ./server/entry.node-server.js",
    "qwik": "qwik",
    "check:i18n": "bun scripts/check-i18n.ts"
  },
  "dependencies": {
    "@revenuecat/purchases-js": "^1.46.0",
    "posthog-js": "^1.205.0"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "undici": "^6.21.0",
    "vite": "^5.4.11"
  }
}
