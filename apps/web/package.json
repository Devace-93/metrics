{
  "name": "@metrics/web",
  "version": "0.1.0",
  "description": "metrics \u2014 Qwik City frontend (marketing + dashboard) for the metrics feature-flag service",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "bun run check:i18n && bun run build.types && bun run build.client && bun run build.server",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/node-server/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "dev": "vite --mode ssr",
    "preview": "qwik build preview && vite preview --open",
    "serve": "bun ./server/entry.node-server.js",
    "start": "bun ./server/entry.node-server.js",
    "qwik": "qwik",
    "check:i18n": "bun scripts/check-i18n.ts"
  },
  "dependencies": {
    "@revenuecat/purchases-js": "^1.73.1",
    "posthog-js": "^1.438.21"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.2",
    "@builder.io/qwik-city": "^1.20.2",
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "undici": "^6.29.1",
    "vite": "^7.3.7"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "postcss-selector-parser": "^7.1.6"
  }
}
